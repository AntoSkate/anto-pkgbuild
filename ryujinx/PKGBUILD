_sdkver="10.0.100"
pkgname="ryujinx"
pkgver=1.3.231
pkgrel=1
pkgdesc="Nintendo Switch emulator written in C#, originally created by gdkchan."
arch=('x86_64')
url="https://ryujinx.app"
license=(MIT)
depends=(sdl3)
makedepends=(git)
options=(!strip)
source=("git+https://git.ryujinx.app/ryubing/ryujinx.git"
        "https://dotnetcli.azureedge.net/dotnet/Sdk/$_sdkver/dotnet-sdk-$_sdkver-linux-x64.tar.gz")
sha256sums=('SKIP'
            'a9631cc6bfad0ef167383ac654b54254bad95a6fb4b6f4309fa78f558055e637')

pkgver() {
	git -C ryujinx describe --tags --abbrev=0 | sed 's/Canary-//'
}

build() {
	export DOTNET_CLI_TELEMETRY_OPTOUT=1 \
	       NUGET_PACKAGES="${srcdir}/nuget" \
	       PATH+=":${srcdir}"

	local options=(
		-c Release
		-p:DebugSymbols=false
		-p:ExtraDefineConstants=DISABLE_UPDATER
		-p:SourceRevisionId="$(git -C ryujinx rev-parse --short HEAD)"
		-p:Version="${pkgver}"
		-r linux-x64
		--self-contained true
	)
	dotnet publish "${options[@]}" -o ryujinx/publish ryujinx/src/Ryujinx	
}

package() {
	rm "${srcdir}/ryujinx/publish/libSDL3.so"
	mkdir -p "${pkgdir}/opt"
	cp -R "${srcdir}/ryujinx/publish" "${pkgdir}/opt/Ryujinx"
	mkdir -p "${pkgdir}/usr/bin"
	ln -s "/opt/Ryujinx/Ryujinx" "${pkgdir}/usr/bin/Ryujinx"

	sed -i 's/.sh//' "${srcdir}/ryujinx/distribution/linux/Ryujinx.desktop"
	install -Dm644 "${srcdir}/ryujinx/distribution/linux/Ryujinx.desktop" "${pkgdir}/usr/share/applications/Ryujinx.desktop"
	install -Dm644 "${srcdir}/ryujinx/distribution/linux/mime/Ryujinx.xml" "${pkgdir}/usr/share/mime/packages/Ryujinx.xml"
	install -Dm644 "${srcdir}/ryujinx/distribution/misc/Logo.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/Ryujinx.svg"	
}
