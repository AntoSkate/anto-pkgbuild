pkgname="egl-wayland2-git"
pkgver=1.0.0.rc.r47.g3e5b643
pkgrel=1
pkgdesc="Dma-buf-based Wayland external platform library"
arch=('x86_64')
url="https://github.com/NVIDIA/egl-wayland2"
license=(Apache-2.0)
depends=(eglexternalplatform
         glibc
         libdrm
         mesa
         wayland)
makedepends=(git
             libglvnd
             meson
             ninja
             pkgconf
             wayland-protocols)
provides=(egl-wayland egl-wayland2)
conflicts=(egl-wayland egl-wayland2)
source=("git+https://github.com/NVIDIA/egl-wayland2.git")
sha256sums=('SKIP')

pkgver() {
	git -C egl-wayland2 describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
	#printf "r%s.%s" "$(git -C egl-wayland2 rev-list --count HEAD)" "$(git -C egl-wayland2 rev-parse --short=7 HEAD)"
}

build() {
	arch-meson egl-wayland2 egl-wayland2/build
	meson compile -C egl-wayland2/build
}

package() {
	meson install -C egl-wayland2/build --no-rebuild --destdir "$pkgdir"
	install -Dm644 -t "${pkgdir}/usr/share/licenses/egl-wayland2" egl-wayland2/LICENSE
}
