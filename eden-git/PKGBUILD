pkgname="eden-git"
pkgver=0.1.1.r49.ga56b8d3
pkgrel=1
pkgdesc="Experimental open-source emulator for the Nintendo Switch"
arch=('x86_64')
url="https://eden-emu.dev"
license=(GPL-3.0-or-later)
depends=(enet
         ffmpeg
         fmt
         lz4
         mbedtls
         nlohmann-json
         openssl
         opus
         qt6-base
         qt6-multimedia
         qt6-webengine
         quazip-qt6
         sdl2
         zlib
         zstd)
makedepends=(boost
             catch2
             cmake
             git
             glslang
             ninja
             pkgconf
             spirv-headers
             spirv-tools
             vulkan-headers
             vulkan-utility-libraries
             wireless_tools)
provides=(eden)
conflicts=(eden)
source=("eden::git+https://github.com/eden-emulator/mirror.git#branch=master")
sha256sums=('SKIP')

#prepare() {
