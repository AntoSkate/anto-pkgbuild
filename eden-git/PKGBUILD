prepare() {
	cd eden
	git submodule init
	git config submodule.SDL.update none
	git config submodule.Vulkan-Headers.update none
	git config submodule.Vulkan-Utility-Libraries.update none
	git config submodule.VulkanMemoryAllocator.url "$srcdir/VulkanMemoryAllocator"
	git config submodule.breakpad.update none
	git config submodule.cpp-httplib.url "$srcdir/cpp-httplib"
	git config submodule.cpp-jwt.url "$srcdir/cpp-jwt"
	git config submodule.cubeb.url "$srcdir/cubeb"
	git config submodule.discord-rpc.update none
	git config submodule.enet.update none
	git config submodule.externals/boost-headers.url "$srcdir/headers"
	git config submodule.libadrenotools.update none
	git config submodule.libusb.update none
	git config submodule.oaknut.update none
	git config submodule.oboe.update none
	git config submodule.opus.update none
	git config submodule.simpleini.url "$srcdir/simpleini"
	git config submodule.tzdb_to_nx.url "$srcdir/tzdb_to_nx"
	git config submodule.vcpkg.update none
	git config submodule.xbyak.url "$srcdir/xbyak"
	git -c protocol.file.allow=always submodule update

	pushd externals/cubeb
	git config submodule.cmake/sanitizers-cmake.url "$srcdir/sanitizers-cmake"
	git config submodule.googletest.update none
	#git config submodule.src/cubeb-coreaudio-rs.url "$srcdir/cubeb-coreaudio-rs"
	rm -r src/cubeb-coreaudio-rs
	cp -r $srcdir/cubeb-coreaudio-rs src/cubeb-coreaudio-rs
	git config submodule.src/cubeb-pulse-rs.url "$srcdir/cubeb-pulse-rs"
	git -c protocol.file.allow=always submodule update
	popd	

	pushd externals/dynarmic
	git config submodule.biscuit.update none
	git config submodule.catch.update none
	git config submodule.fmt.update none
	git config submodule.mcl.url "$srcdir/mcl"
	git config submodule.oaknut.update none
	git config submodule.unordered_dense.url "$srcdir/unordered_dense"
	git config submodule.xbyak.update none
	git config submodule.zycore.url "$srcdir/zycore-c"
	git config submodule.zydis.url "$srcdir/zydis"
	git -c protocol.file.allow=always submodule update
	popd

	pushd externals/dynarmic/externals/zydis
	git config submodule.dependencies/zycore.url "$srcdir/zycore-c"
	git -c protocol.file.allow=always submodule update
	popd	

	pushd externals/nx_tzdb/tzdb_to_nx
	git config submodule.externals/tz/tz.url "$srcdir/tz"
	git -c protocol.file.allow=always submodule update
	popd
}

pkgver() {
	git -C eden describe --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
	# Build with GCC for now since it optimizes better
	#export CC="clang" \
	#       CXX="clang++" \
	#       CFLAGS=${CFLAGS//-flto=auto/-flto=thin} \
	#       CXXFLAGS=${CXXFLAGS//-flto=auto/-flto=thin} \
	#       CFLAGS+=" -w" \
	#       CXXFLAGS+=" -w" \
	#       LDFLAGS+=" -fuse-ld=lld"

	local cmake_options=(
		-DENABLE_OPENGL=OFF \
		-DENABLE_WEB_SERVICE=ON \
		-DSIRIT_USE_SYSTEM_SPIRV_HEADERS=ON \	
		-DYUZU_CHECK_SUBMODULES=OFF \
		-DYUZU_DOWNLOAD_TIME_ZONE_DATA=ON \
		-DYUZU_ENABLE_LTO=OFF \
		-DYUZU_ENABLE_PORTABLE=OFF \
		-DYUZU_ROOM=OFF \
		-DYUZU_TESTS=OFF \
		-DYUZU_USE_BUNDLED_FFMPEG=OFF \
		-DYUZU_USE_BUNDLED_QT=OFF \
		-DYUZU_USE_BUNDLED_SDL2=OFF \
		-DYUZU_USE_BUNDLED_VCPKG=OFF \
		-DYUZU_USE_EXTERNAL_SDL2=OFF \
		-DYUZU_USE_EXTERNAL_VULKAN_SPIRV_TOOLS=OFF \
		-DYUZU_USE_EXTERNAL_VULKAN_HEADERS=OFF \
		-DYUZU_USE_EXTERNAL_VULKAN_UTILITY_LIBRARIES=OFF \
		-DYUZU_USE_FASTER_LD=OFF \
		-DYUZU_USE_QT_MULTIMEDIA=ON \
		-DYUZU_USE_QT_WEB_ENGINE=ON \
		-Wno-dev
	)

	cmake -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr "${cmake_options[@]}" -S eden -B eden/build -G Ninja
	cmake --build eden/build --config Release
}

package() {
	DESTDIR="${pkgdir}" cmake --install eden/build
	install -Dm644 -t "${pkgdir}/usr/share/licenses/eden" eden/LICENSE.txt
	install -Dm644 -t "${pkgdir}/usr/lib/udev/rules.d" eden/dist/72-yuzu-input.rules
}
